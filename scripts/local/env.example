# Paperclip local harness settings (fork 31erGER).
# Copy to ~/.config/paperclip-local/env; ./paperclip-local.sh loads it.

# standard | local | local_only
#   local      agents run only as host processes (no containers, no Paperclip Runner)
#   local_only local + no price/cost metrics + one model run at a time by default
PAPERCLIP_DEPLOYMENT_PROFILE=local_only

# Pi agents: link your own Pi extensions, packages and settings (~/.pi/agent)
# into Paperclip runs. On by default for the local profiles; 0 switches it off.
# PAPERCLIP_PI_HOST_CONFIG=1

# Bind address and port. Without sign-in, only processes on this machine get
# board access; reach it from another machine through an SSH tunnel
# (ssh -L 3100:127.0.0.1:3100 you@this-host), not with HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3100
