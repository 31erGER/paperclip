# Paperclip local harness settings (fork 31erGER).
# Copy to ~/.config/paperclip-local/env; scripts/local/paperclip-local.sh loads it.

# standard | local | local_only
#   local      agents run only as host processes (no containers, no Paperclip Runner)
#   local_only local + no price/cost metrics + one model run at a time by default
PAPERCLIP_DEPLOYMENT_PROFILE=local_only

# Bind address and port. Use HOST=0.0.0.0 to reach the board from other machines
# on a trusted network.
HOST=127.0.0.1
PORT=3100
